{
  "manifest_version": 3,
  "name": "DISTILL",
  "version": "1.0.0",
  "description": "TL;DR any website. Click the icon for the main idea, key points, figures and keywords. Nothing leaves your browser.",
  "homepage_url": "https://github.com/shmidtqq65/distill",
  "minimum_chrome_version": "105",
  "action": {
    "default_title": "Distill this page (Alt+Shift+D)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Distill this page (press again to put it back)"
    }
  }
}
